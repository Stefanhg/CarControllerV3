	)
	(text "Shunt driver \"S+\" = 1.38V in R, 0.19V in F\nShunt driver \"S-\", frame connection (connection to the frame?)\nInput NTC resistor 30k\nGND NTC Resistance\nAcctor Speeder Contact. Speeder OFF = 72V\n- No connection"
		(exclude_from_sim no)
		(at 215.392 53.594 0)
